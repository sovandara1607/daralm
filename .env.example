# DaraLM environment variables
# Copy this file to .env and fill in real values. Never commit .env.
#
# Not required for Phase 0 (project foundation). These are placeholders for
# later phases (experiment tracking, tokenizer/dataset downloads, serving).

# Weights & Biases API key (experiment tracking, later phases)
WANDB_API_KEY=

# Hugging Face access token (tokenizer/dataset downloads, later phases)
HF_TOKEN=

# Default device override: cuda | mps | cpu (leave empty for auto-detect)
DARALM_DEVICE=

# Logging level: DEBUG | INFO | WARNING | ERROR
DARALM_LOG_LEVEL=INFO
