# DaraLM environment variables
# Copy to .env and never commit real secrets.

# Experiment tracking
WANDB_API_KEY=

# Dataset access
HF_TOKEN=

# cuda | mps | cpu; empty means auto-detect
DARALM_DEVICE=

# DEBUG | INFO | WARNING | ERROR
DARALM_LOG_LEVEL=INFO

# 1/true/yes to serve a dynamically int8-quantized model (CPU only — logs a
# warning and falls back to unquantized on cuda/mps, since PyTorch's dynamic
# quantization backend has no kernels for them). See daralm/inference/quantization.py.
DARALM_QUANTIZE=
